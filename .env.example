# ---------------------------------------------------------------------------
# PlanPal — environment variable template.
#
# Copy to a real, gitignored env file for the environment you're targeting:
#   cp .env.example .env            # local dev default
#   cp .env.dev.example .env.dev    # dev cloud project
#   ... and so on for .env.staging / .env.prod
#
# RULES:
#  - Never commit real values. Only *.example files are tracked.
#  - PUBLIC-prefixed vars (EXPO_PUBLIC_*, NEXT_PUBLIC_*) ship to the client and
#    must contain ONLY non-secret values (URL + anon key).
#  - SERVICE_ROLE keys and all provider secrets are server-only. Never expose
#    them to a client bundle.
#  - See docs/SECRETS.md for where each secret lives and the rotation policy.
# ---------------------------------------------------------------------------

# --- Environment selector ---
NODE_ENV=development
PLANPAL_ENV=dev                       # one of: dev | staging | prod

# --- Supabase (client-safe) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public demo account (client-safe, published on purpose) ---
# The "Try the demo" button on /sign-in signs in with these through the normal
# password flow. They are deliberately public: the account holds nothing but
# generated sample data and is reseeded nightly. Defaults live in
# apps/web/src/lib/demo.ts, so these are only needed to point a fork at its own
# demo project. Set NEXT_PUBLIC_DEMO_ENABLED=false to hide the button.
NEXT_PUBLIC_DEMO_EMAIL=demo@planpal.app
NEXT_PUBLIC_DEMO_PASSWORD=planpal-demo
NEXT_PUBLIC_DEMO_ENABLED=true

# --- Supabase (server-only — NEVER bundle into a client) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                      # postgres connection string for migrations

# --- Auth providers (server-only) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# --- Claude / Anthropic (server-only; used by the Beta parse pipeline) ---
ANTHROPIC_API_KEY=

# --- Upstash Redis (server-only; job queue for the M5 parse pipeline) ---
# Create a project at upstash.com → copy the REST URL and token.
# Set the same values as Edge Function secrets: supabase secrets set ...
# Without these the parse Edge Function will queue jobs in the DB only
# (polling fallback) and log a warning. Set before running parse-worker.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AWS (server-only; Textract OCR fallback in parse-worker) ---
# Create an IAM user with AmazonTextractFullAccess (or a scoped policy).
# Set as Edge Function secrets: supabase secrets set AWS_ACCESS_KEY_ID=... etc.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Spend kill-switch (server-only; M5 cross-cutting cost monitoring) ---
# Trailing-24h Claude spend across ALL users, in USD, above which the `parse`
# function refuses new jobs with 503 SERVICE_UNAVAILABLE. Unset disables the
# kill switch entirely — it does not default on. See supabase/functions/_shared/spend.ts.
PARSE_DAILY_SPEND_LIMIT_USD=

# --- Microsoft Graph (server-only; V1 Outlook one-way sync) ---
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Snap Creative Kit (V1 social share) ---
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=

# --- Observability ---
# Sentry DSNs are publishable (safe in a client bundle). The server-only DSN is
# kept for server/edge runtimes; the PUBLIC ones are read by the app scaffolds.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# PostHog project keys are client-safe (write-only ingestion keys).
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Environment label surfaced to client-side Sentry (dev | staging | prod).
NEXT_PUBLIC_PLANPAL_ENV=dev
EXPO_PUBLIC_PLANPAL_ENV=dev

# Shared secret the notify-scheduler function requires as an `X-Cron-Secret`
# header. Without it the endpoint is reachable by anyone holding the (public)
# anon key. Server-only — never a PUBLIC_ prefix.
#
# The same value must also exist as the `cron_secret` vault entry in the
# database, which is what the pg_cron job sends; see docs/SECRETS.md.
#
# For LOCAL integration runs of the scheduler this belongs in
# `supabase/functions/.env`, not here — the Edge runtime reads that file at
# `supabase start`. See docs/TESTING.md.
CRON_SECRET=
