# ---------------------------------------------------------------------------
# PlanPal — environment variable template.
#
# Copy to a real, gitignored env file for the environment you're targeting:
#   cp .env.example .env            # local dev default
#   cp .env.dev.example .env.dev    # dev cloud project
#   ... and so on for .env.staging / .env.prod
#
# RULES:
#  - Never commit real values. Only *.example files are tracked.
#  - PUBLIC-prefixed vars (EXPO_PUBLIC_*, NEXT_PUBLIC_*) ship to the client and
#    must contain ONLY non-secret values (URL + anon key).
#  - SERVICE_ROLE keys and all provider secrets are server-only. Never expose
#    them to a client bundle.
#  - See docs/SECRETS.md for where each secret lives and the rotation policy.
# ---------------------------------------------------------------------------

# --- Environment selector ---
NODE_ENV=development
PLANPAL_ENV=dev                       # one of: dev | staging | prod

# --- Supabase (client-safe) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER bundle into a client) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                      # postgres connection string for migrations

# --- Auth providers (server-only) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# --- Claude / Anthropic (server-only; used by the Beta parse pipeline) ---
ANTHROPIC_API_KEY=

# --- Microsoft Graph (server-only; V1 Outlook one-way sync) ---
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Snap Creative Kit (V1 social share) ---
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=

# --- Observability ---
# Sentry DSNs are publishable (safe in a client bundle). The server-only DSN is
# kept for server/edge runtimes; the PUBLIC ones are read by the app scaffolds.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# PostHog project keys are client-safe (write-only ingestion keys).
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Environment label surfaced to client-side Sentry (dev | staging | prod).
NEXT_PUBLIC_PLANPAL_ENV=dev
EXPO_PUBLIC_PLANPAL_ENV=dev

# Shared secret the notify-scheduler function requires as an `X-Cron-Secret`
# header. Without it the endpoint is reachable by anyone holding the (public)
# anon key. Server-only — never a PUBLIC_ prefix.
#
# The same value must also exist as the `cron_secret` vault entry in the
# database, which is what the pg_cron job sends; see docs/SECRETS.md.
#
# For LOCAL integration runs of the scheduler this belongs in
# `supabase/functions/.env`, not here — the Edge runtime reads that file at
# `supabase start`. See docs/TESTING.md.
CRON_SECRET=
