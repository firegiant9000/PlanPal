{
  "name": "@planpal/integration-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Integration suite that invokes the Edge Functions over HTTP against the local Supabase stack (pnpm db:start). Not part of `turbo run test` — it needs Docker.",
  "type": "module",
  "scripts": {
    "test:integration": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf .turbo coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@planpal/api-client": "workspace:^",
    "@planpal/recurrence": "workspace:^"
  }
}
