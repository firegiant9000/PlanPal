{
  "name": "@planpal/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-agnostic design tokens — the single source of truth for color, spacing, type, and radius across mobile and web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
