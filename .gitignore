# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.expo/
.turbo/
*.tsbuildinfo

# Generated framework ambient types (regenerated on build; committed equivalents
# live in-tree: apps/web/src/next-ambient.d.ts, apps/mobile/expo-env.d.ts)
next-env.d.ts

# Test / coverage
coverage/

# Environment & secrets — NEVER commit real values (templates are *.example)
.env
.env.*
!.env.example
!.env.*.example

# Supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code — .claude/settings.json is shared; local overrides are personal
.claude/settings.local.json

# Exported calendars. These are real user data — event titles, times and
# locations — and are produced by GET /export/ical during manual testing.
*.ics
