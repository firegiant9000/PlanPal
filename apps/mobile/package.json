{
  "name": "@planpal/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "PlanPal mobile app (Expo / React Native, expo-router). Implements the shared @planpal/ui contracts with native primitives.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android --output-dir dist",
    "lint": "eslint app src",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .expo .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@planpal/analytics": "workspace:*",
    "@planpal/api-client": "workspace:^",
    "@planpal/calendar-core": "workspace:*",
    "@planpal/design-tokens": "workspace:*",
    "@planpal/recurrence": "workspace:^",
    "@planpal/types": "workspace:*",
    "@planpal/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~6.22.0",
    "expo": "~53.0.27",
    "expo-device": "~7.1.4",
    "expo-notifications": "~0.32.17",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "posthog-react-native": "^4.78.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "~4.28.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.14",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3"
  }
}
