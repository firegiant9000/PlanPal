{
  "name": "@planpal/web",
  "version": "0.0.0",
  "private": true,
  "description": "PlanPal web app (Next.js App Router). Implements the shared @planpal/ui contracts against the DOM.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .next .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@planpal/analytics": "workspace:*",
    "@planpal/api-client": "workspace:^",
    "@planpal/calendar-core": "workspace:^",
    "@planpal/design-tokens": "workspace:*",
    "@planpal/recurrence": "workspace:^",
    "@planpal/types": "workspace:*",
    "@planpal/ui": "workspace:*",
    "@sentry/nextjs": "^8.35.0",
    "next": "^15.0.2",
    "posthog-js": "^1.181.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.8.1",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "jsdom": "^30.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
