{
  "name": "planpal",
  "version": "0.0.0",
  "private": true,
  "description": "PlanPal monorepo — Expo (mobile) + Next.js (web) + shared packages, on Supabase.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @planpal/integration-tests test:integration",
    "contract:validate": "turbo run validate --filter=@planpal/api-contract",
    "contract:generate": "turbo run generate --filter=@planpal/api-contract",
    "recurrence:sync": "node scripts/sync-recurrence-edge.mjs",
    "recurrence:check": "node scripts/sync-recurrence-edge.mjs --check",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "npx --yes supabase@2.117.0 start",
    "db:stop": "npx --yes supabase@2.117.0 stop",
    "db:reset": "npx --yes supabase@2.117.0 db reset",
    "db:diff": "npx --yes supabase@2.117.0 db diff",
    "db:push": "npx --yes supabase@2.117.0 db push"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.3"
  }
}
