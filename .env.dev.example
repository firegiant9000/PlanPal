# DEV cloud environment. Copy to .env.dev (gitignored) and fill from the DEV
# Supabase project + the dev secrets store. See .env.example for the full key
# list and docs/SECRETS.md for sourcing. DEV may use test/sandbox provider
# credentials and looser limits; it must never point at staging/prod resources.
PLANPAL_ENV=dev
NODE_ENV=development
