# pnpm — hoist nothing by default; let Expo/Next resolve their own deps strictly.
# node-linker=hoisted is required by Expo/Metro, which does not support pnpm's
# symlinked node_modules layout. See https://docs.expo.dev/guides/monorepos/
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
